  DEPARTMENTS -> DOCTORS [dir=both, arrowtail=tee, arrowhead=crow, label=" employs "];
  PATIENTS -> APPOINTMENTS [dir=both, arrowtail=tee, arrowhead=crow, label=" books "];
  DOCTORS -> APPOINTMENTS [dir=both, arrowtail=tee, arrowhead=crow, label=" attends "];
