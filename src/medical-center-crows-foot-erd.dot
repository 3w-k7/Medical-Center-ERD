digraph HospitalERD {
  graph [rankdir=LR, splines=ortho, nodesep=0.55, ranksep=1.15, pad=0.35, bgcolor="#0E1423", fontname="DejaVu Sans", overlap=false, outputorder=edgesfirst];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#C7D3E3", penwidth=1.35, arrowsize=0.8, fontname="DejaVu Sans", fontsize=10, fontcolor="#EAF0F7"];

